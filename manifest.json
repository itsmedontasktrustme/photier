{
  "manifest_version": 3,
  "name": "Gemini Page Evaluator",
  "description": "Select a page area and send it to Gemini for evaluation.",
  "version": "1.0.0",
  "permissions": ["activeTab", "storage", "tabs", "contextMenus", "scripting"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_title": "Select area for Gemini"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
